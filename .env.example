# Baby Diary API Environment Variables
# Copy this file to .env and fill in your actual values

# Application
APP_NAME=Baby Diary API
APP_VERSION=1.0.0
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/baby_diary

# WeChat Mini-program Authentication
# Get these from WeChat Mini-program Admin Console
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# JWT Authentication
# Generate a secure random key for production
JWT_SECRET=your-secure-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins for production)
CORS_ORIGINS=["*"]

# Qwen LLM Configuration (Alibaba Cloud)
# Get API key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_MODEL=qwen-turbo