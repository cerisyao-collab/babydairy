# Test Environment Configuration
# Copy this file to .env.test and adjust as needed

# Test Database (Docker PostgreSQL)
DATABASE_URL=postgresql://test:test@localhost:5433/baby_diary_test

# WeChat (mocked in tests)
WECHAT_APP_ID=test_app_id
WECHAT_APP_SECRET=test_app_secret

# JWT (test secret)
JWT_SECRET=test-jwt-secret-for-testing-only

# LLM (mocked in tests)
DASHSCOPE_API_KEY=test_dashscope_key
QWEN_MODEL=qwen-turbo

# OSS (mocked in tests)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_SECRETS_BUCKET=test-bucket

# Key backup (for testing)
KEY_BACKUP_PASSWORD=test-backup-password

# App settings
DEBUG=true
APP_NAME=Baby Diary API Test