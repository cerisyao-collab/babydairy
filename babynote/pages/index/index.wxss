/* 页面整体容器 */
.container {
  padding: 40rpx 32rpx 140rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
  box-sizing: border-box;
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 操作按钮区域 */
.action-buttons {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 60rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 260rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s, box-shadow 0.2s;
}

.action-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.action-btn.feeding {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.action-btn.formula {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.action-btn.diaper {
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
}

.action-btn.supplement {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.btn-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
}

/* 通用弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end; /* 底部弹出 */
  justify-content: center;
  z-index: 1000;
}

/* 弹窗主体 */
.modal-content {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(100rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 弹窗头部 */
.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 弹窗内容，可滚动 */
.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 32rpx;
}

/* 弹窗底部固定按钮 */
.modal-footer {
  display: flex;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #eee;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: none;
  text-align: center;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 选项组 */
.option-group {
  margin-bottom: 32rpx;
}

.option-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 16rpx;
}

/* 单选按钮 */
.option-buttons {
  display: flex;
  gap: 16rpx;
}

.option-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f8f9fa;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.option-btn.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(102,126,234,0.3);
}

/* 多选按钮 */
.option-buttons-multi {
  display: flex;
  gap: 16rpx;
}

.option-btn-multi {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f8f9fa;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.option-btn-multi.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(102,126,234,0.3);
}

/* 输入框 + 添加按钮 */
.input-group {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.supplement-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e0e0e0;
  background: #f8f9fa;
}

.add-btn {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: none;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 已添加营养品列表 */
.supplement-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.supplement-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  border-radius: 24rpx;
  background: #f8f9fa;
  border: 2rpx solid #e0e0e0;
  transition: all 0.3s;
}

.supplement-item.selected {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-color: #667eea;
  box-shadow: 0 4rpx 12rpx rgba(102,126,234,0.3);
}

.check-icon {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
}

/* 滑动条 */
.slider-container {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

slider {
  flex: 1;
}

.slider-value {
  min-width: 100rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
  margin-left: 16rpx;
}

.slider-marks {
  display: flex;
  justify-content: space-between;
  padding: 0 4rpx;
}

.slider-marks text {
  font-size: 22rpx;
  color: #999;
}