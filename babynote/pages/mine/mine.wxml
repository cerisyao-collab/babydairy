<view class="container">
  <!-- 用户登录 -->
  <view wx:if="{{!hasAuth}}" class="section">
    <button class="btn" bindtap="handleLogin">微信登录</button>
  </view>
  <view wx:if="{{hasAuth}}" class="section user-info">
    <image src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" class="avatar" />
    <view class="nick">{{userInfo.nickName || '宝宝家长'}}</view>
    <button class="btn-secondary" bindtap="handleLogout">退出登录</button>
  </view>

  <!-- 宝宝信息 -->
  <view wx:if="{{hasAuth}}" class="section card">
    <view class="section-title">👶 宝宝信息</view>
    <view class="baby-info" bindtap="onEditBaby">
      <text class="baby-name">{{babyConfig.baby_name || '宝宝'}}</text>
      <text class="baby-edit">点击编辑</text>
    </view>
    <view wx:if="{{babyConfig.gender}}">性别：{{babyConfig.gender === 'male' ? '男' : (babyConfig.gender === 'female' ? '女' : '')}}</view>
    <view wx:if="{{babyConfig.birth_date}}">生日：{{babyConfig.birth_date}}</view>
    <view wx:if="{{babyConfig.age_days !== null}}">年龄：{{babyConfig.age_days}}天</view>
    <view wx:if="{{babyConfig.birth_weight}}">出生体重：{{babyConfig.birth_weight}}kg</view>
  </view>

  <!-- 宝宝编辑弹窗 -->
  <view wx:if="{{showBabyModal}}" class="modal-mask" bindtap="closeBabyModal">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">编辑宝宝信息</view>
      <input placeholder="姓名" data-field="babyName" bindinput="onInputChange" value="{{babyName}}" class="input"/>
      <view class="gender-select">
        <text class="gender-btn {{babyGender=='男'?'active':''}}" data-value="男" bindtap="selectGender">男</text>
        <text class="gender-btn {{babyGender=='女'?'active':''}}" data-value="女" bindtap="selectGender">女</text>
      </view>
      <picker mode="date" bindchange="selectBirthday" value="{{babyBirthday}}">
        <view class="picker">{{babyBirthday || '生日 YYYY-MM-DD'}}</view>
      </picker>
      <input placeholder="出生体重(kg)" data-field="babyHeight" bindinput="onInputChange" class="input"/>
      <button class="btn" bindtap="saveBabyConfig">保存</button>
      <button class="btn-cancel" bindtap="closeBabyModal">取消</button>
    </view>
  </view>

  <!-- 我的记录 -->
  <view wx:if="{{hasAuth}}" class="section card">
    <view class="section-title">我的记录</view>
    <view wx:if="{{myRecords.length === 0}}" class="empty">暂无记录</view>
    <view wx:for="{{myRecords}}" wx:key="id" class="record-item">
      <view class="record-header">
        <text class="record-type">{{item.displayType}}</text>
        <text class="record-time">{{item.displayTime}}</text>
      </view>
      <view class="record-value">{{item.displayValue}}</view>
      <view class="record-user">记录者：{{item.displayUserName}}</view>
      <button class="btn-delete" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
    </view>
  </view>
</view>
