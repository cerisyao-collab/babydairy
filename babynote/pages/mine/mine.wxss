.container {
  padding: 30rpx;
  background: #f6f7fb;
  min-height: 100vh;
  font-size: 28rpx;
}

/* ===== 区块 ===== */
.section {
  margin-bottom: 30rpx;
}

.card {
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

/* ===== 用户 ===== */
.user-info {
  text-align: center;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
.nick {
  margin-top: 10rpx;
  font-weight: 600;
  color: #333;
}

/* ===== 按钮 ===== */
.btn {
  display: block;
  width: 100%;
  padding: 14rpx 0;
  margin-top: 12rpx;
  text-align: center;
  background: #667eea;
  color: #fff;
  border-radius: 999rpx;
}
.btn-cancel {
  display: block;
  width: 100%;
  padding: 14rpx 0;
  margin-top: 12rpx;
  text-align: center;
  background: #bbb;
  color: #fff;
  border-radius: 999rpx;
}
.btn-edit {
  display: inline-block;
  margin-right: 10rpx;
  padding: 6rpx 12rpx;
  background: #f0ad4e;
  color: #fff;
  border-radius: 6rpx;
}
.btn-delete {
  display: inline-block;
  margin-left: 10rpx;
  padding: 6rpx 12rpx;
  background: #e74c3c;
  color: #fff;
  border-radius: 6rpx;
}
.btn-secondary {
  display: block;
  width: 100%;
  padding: 14rpx 0;
  margin-top: 12rpx;
  text-align: center;
  background: #f85149;
  color: #fff;
  border-radius: 999rpx;
}

/* ===== 输入框 ===== */
.input {
  width: 100%;
  padding: 12rpx;
  margin: 8rpx 0;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

/* ===== 宝宝性别选择 ===== */
.gender-select {
  display: flex;
  gap: 20rpx;
  margin: 10rpx 0;
}
.gender-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  color: #333;
}
.gender-btn.active {
  background: #667eea;
  color: #fff;
  border-color: #667eea;
}

/* ===== 日期选择 ===== */
.picker {
  padding: 12rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  margin: 8rpx 0;
}

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.4);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}
.modal-content {
  width: 680rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  color: #bbb;
  padding: 40rpx 0;
}
.record-item {
  border-bottom: 1rpx solid #eee;
  padding: 12rpx 0;
}
.record-item:last-child {
  border-bottom: none;
}
.record-header {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 4rpx;
}
.record-type {
  font-weight: 600;
}
.record-time {
  color: #999;
}
.record-value {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}
.record-user {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}
