<view class="container">

<!-- 标题 -->
<view class="header">
  <view class="title">📊 记录中心</view>
  <view class="subtitle">宝宝成长与日常记录</view>
</view>

<!-- 分类筛选 -->
<view class="filter-bar">
  <view class="filter-btn {{filter==='all'?'active':''}}" data-type="all" bindtap="onFilterChange">全部</view>
  <view class="filter-btn {{filter==='feeding'?'active':''}}" data-type="feeding" bindtap="onFilterChange">喂养</view>
  <view class="filter-btn {{filter==='diaper'?'active':''}}" data-type="diaper" bindtap="onFilterChange">排便</view>
  <view class="filter-btn {{filter==='care'?'active':''}}" data-type="care" bindtap="onFilterChange">护理</view>
  <view class="filter-btn {{filter==='growth'?'active':''}}" data-type="growth" bindtap="onFilterChange">生长</view>
  <view class="filter-btn {{filter==='medication'?'active':''}}" data-type="medication" bindtap="onFilterChange">营养品</view>
</view>

<!-- 表格 -->
<view class="table">

<!-- 表头 -->
<view class="table-header">
  <view class="col">类型</view>
  <view class="col">内容</view>
  <view class="col">时间</view>
  <view class="col">记录人</view>
</view>

<!-- 空状态 -->
<view wx:if="{{records.length === 0}}" class="empty">
  暂无数据
</view>

<!-- 数据 -->
<view wx:for="{{records}}" wx:key="index" class="table-row">
  <view class="col">{{item.displayType}}</view>
  <view class="col">{{item.displayValue}}</view>
  <view class="col time-col">{{item.displayTime}}</view>
  <view class="col">{{item.displayUser_name}}</view>
</view>

</view>

</view>

