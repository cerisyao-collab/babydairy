def init_storage() -> bool:
    """初始化存储目录"""
    try:
        RECORDS_DIR.mkdir(parents=True, exist_ok=True)
        IMAGES_DIR.mkdir(parents=True, exist_ok=True)
        return True
    except Exception:
        return False


def get_record_file_path(date: datetime) -> Path:
    """获取指定日期记录文件的路径 (YYYY-MM-DD.json)"""
    year_month_day = date.strftime("%Y-%m-%d")
    return RECORDS_DIR / f"{year_month_day}.json"


def get_index_file_path() -> Path:
    """获取索引文件路径"""
    return RECORDS_DIR / "index.json"


def load_records_from_file(file_path: Path) -> List[Dict[str, Any]]:
    """从文件加载记录"""
    if not file_path.exists():
        return []
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            return json.load(f)
    except (json.JSONDecodeError, IOError):
        return []


def save_records_to_file(file_path: Path, records: List[Dict[str, Any]]) -> bool:
    """保存记录到文件"""
    try:
        with open(file_path, "w", encoding="utf-8") as f:
            json.dump(records, f, ensure_ascii=False, indent=2)
        return True
    except IOError:
        return False


def load_index(force_refresh: bool = False) -> Dict[str, Any]:
    """
    加载索引文件（带缓存失效检查）

    Args:
        force_refresh: 如果为 True，强制重新加载索引

    Returns:
        索引字典
    """
    global _index_cache, _index_mtime

    index_path = get_index_file_path()

    # Check if we should use cached index
    if not force_refresh and _index_cache is not None:
        # Check if index file has been modified
        if index_path.exists():
            current_mtime = index_path.stat().st_mtime
            if current_mtime == _index_mtime:
                return _index_cache
        else:
            # Index file was deleted, reset cache
            _index_cache = None
            _index_mtime = 0.0

    # Load fresh index
    if not index_path.exists():
        _index_cache = {"version": "1.0", "updated": datetime.now().isoformat(), "days": {}}
    else:
        try:
            with open(index_path, "r", encoding="utf-8") as f:
                _index_cache = json.load(f)
            _index_mtime = index_path.stat().st_mtime
        except (json.JSONDecodeError, IOError):
            _index_cache = {"version": "1.0", "updated": datetime.now().isoformat(), "days": {}}
            _index_mtime = 0.0

    return _index_cache if _index_cache else {"version": "1.0", "updated": datetime.now().isoformat(), "days": {}}


def refresh_index() -> Dict[str, Any]:
    """
    强制刷新索引（从磁盘重新加载）

    Returns:
        刷新后的索引字典
    """
    return load_index(force_refresh=True)


def save_index(index: Dict[str, Any]) -> bool:
    """保存索引文件"""
    global _index_cache, _index_mtime
    index_path = get_index_file_path()
    index["updated"] = datetime.now().isoformat()
    try:
        with open(index_path, "w", encoding="utf-8") as f:
            json.dump(index, f, ensure_ascii=False, indent=2)
        # Update cache after successful save
        _index_cache = index
        _index_mtime = index_path.stat().st_mtime
        return True
    except IOError:
        return False


def check_duplicate_records(
    record_type: str,
    timestamp: datetime,
    window_minutes: int = DEFAULT_DUPLICATE_WINDOW_MINUTES
) -> List[Dict[str, Any]]:
    """
    检查时间窗口内是否存在相似记录

    Args:
        record_type: 记录类型
        timestamp: 新记录的时间戳
        window_minutes: 时间窗口（分钟），默认 5 分钟

    Returns:
        相似记录列表，如果为空则表示无重复
    """
    # 加载当日已有记录
    file_path = get_record_file_path(timestamp)
    records = load_records_from_file(file_path)

    # 过滤同类型且在时间窗口内的记录
    similar = []
    for r in records:
        r_time = datetime.fromisoformat(r["timestamp"])
        if r["type"] == record_type and abs((timestamp - r_time).total_seconds()) <= window_minutes * 60:
            similar.append(r)

    return similar


def format_duplicate_confirmation_message(similar_records: List[Dict[str, Any]]) -> str:
    """
    格式化重复记录的确认提示信息

    Args:
        similar_records: 相似记录列表

    Returns:
        格式化的提示消息
    """
    if not similar_records:
        return ""

    lines = ["检测到短时间内已有相似记录：", ""]
    for i, r in enumerate(similar_records, 1):
        ts = r.get("timestamp", "")[:16]  # 只显示到分钟
        rec_type = RECORD_TYPE_NAMES.get(r["type"], r["type"])
        details = r.get("details", {})
        detail_str = ", ".join(f"{k}={v}" for k, v in details.items() if k != "timestamp")
        lines.append(f"  {i}. [{ts}] {rec_type}: {detail_str}")

    lines.append("")
    lines.append("是否继续创建新记录？(确认/取消)")
    return "\n".join(lines)


def update_index_for_record(record: Dict[str, Any], action: str) -> bool:
    """
    更新索引（添加或移除记录）

    Args:
        record: 记录对象
        action: "add" 或 "remove"
    """
    index = load_index()
    date = record.get("date", "")
    record_type = record.get("type", "")

    if not date:
        return False

    if date not in index["days"]:
        index["days"][date] = {
            "file": f"{date}.json",
            "count": 0,
            "sizeBytes": 0,
            "types": []
        }

    day_info = index["days"][date]

    if action == "add":
        day_info["count"] = day_info.get("count", 0) + 1
        if record_type and record_type not in day_info.get("types", []):
            day_info.setdefault("types", []).append(record_type)
    elif action == "remove":
        day_info["count"] = max(0, day_info.get("count", 0) - 1)

    # 更新文件大小
    file_path = RECORDS_DIR / f"{date}.json"
    if file_path.exists():
        day_info["sizeBytes"] = file_path.stat().st_size

    # 如果 count 为 0，移除该日期条目
    if day_info["count"] == 0:
        del index["days"][date]

    return save_index(index)


def record_create(
    record_type: str,
    details: Dict[str, Any],
    timestamp: Optional[str] = None,
    images: Optional[List[str]] = None,
    skip_confirmation: bool = False,
    window_minutes: int = DEFAULT_DUPLICATE_WINDOW_MINUTES,
) -> Dict[str, Any]:
    """
    创建新记录

    Args:
        record_type: 记录类型 (feeding, bowel, urine, medication, bathing, sleep, growth)
        details: 类型特定的详情
        timestamp: 时间戳 (ISO format), 默认当前时间
        images: 图片路径列表
        skip_confirmation: 是否跳过重复确认 (默认 False)
        window_minutes: 重复检测时间窗口（分钟），默认 5 分钟

    Returns:
        创建的记录字典

    Raises:
        DuplicateRecordError: 当检测到重复记录且用户未确认时抛出
    """
    if record_type not in RECORD_TYPES:
        raise ValueError(f"Invalid record type: {record_type}. Must be one of {RECORD_TYPES}")

    if timestamp is None:
        # 统一 timestamp 格式为 YYYY-MM-DDTHH:MM:SS（不带微秒）
        timestamp = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")

    # 解析时间戳用于重复检测
    ts_datetime = datetime.fromisoformat(timestamp)

    # 检查重复记录（除非跳过确认）
    if not skip_confirmation:
        similar_records = check_duplicate_records(record_type, ts_datetime, window_minutes)
        if similar_records:
            raise DuplicateRecordError(
                similar_records,
                format_duplicate_confirmation_message(similar_records)
            )

    record = {
        "id": str(uuid.uuid4()),
        "type": record_type,
        "timestamp": timestamp,
        "date": datetime.fromisoformat(timestamp).strftime("%Y-%m-%d"),
        "details": details,
        "images": images or [],
    }

    # 加载现有记录
    file_path = get_record_file_path(datetime.fromisoformat(timestamp))
    records = load_records_from_file(file_path)

    # 添加新记录并保存
    records.append(record)
    save_records_to_file(file_path, records)

    # 更新索引
    update_index_for_record(record, "add")

    return record


def record_query(
    start_date: Optional[str] = None,
    end_date: Optional[str] = None,
    record_type: Optional[str] = None,
) -> List[Dict[str, Any]]:
    """
    查询记录

    Args:
        start_date: 开始日期 (YYYY-MM-DD)
        end_date: 结束日期 (YYYY-MM-DD)
        record_type: 记录类型过滤

    Returns:
        匹配的记录列表
    """
    init_storage()

    results = []

    # 确定日期范围
    if start_date:
        start_dt = datetime.fromisoformat(start_date)
    else:
        start_dt = datetime(2020, 1, 1)  # 默认最早日期

    if end_date:
        end_dt = datetime.fromisoformat(end_date)
    else:
        end_dt = datetime.now()

    # Convert to string for comparison
    start_date_str = start_dt.strftime("%Y-%m-%d")
    end_date_str = end_dt.strftime("%Y-%m-%d")

    # Load index to get list of days with records
    index = load_index()

    # Iterate through days in index that fall within the date range
    for day_str in sorted(index["days"].keys()):
        if day_str < start_date_str or day_str > end_date_str:
            continue

        # Optional: skip if record type filter doesn't match
        if record_type:
            day_types = index["days"][day_str].get("types", [])
            if record_type not in day_types:
                continue

        file_path = RECORDS_DIR / f"{day_str}.json"
        records = load_records_from_file(file_path)

        for record in records:
            # 类型过滤
            if record_type and record.get("type") != record_type:
                continue

            results.append(record)

    # 按时间排序
    results.sort(key=lambda x: x.get("timestamp", ""), reverse=True)

    return results


def record_list(date: Optional[str] = None) -> List[Dict[str, Any]]:
    """
    列出某日的所有记录

    Args:
        date: 日期 (YYYY-MM-DD), 默认今天

    Returns:
        该日的所有记录列表
    """
    if date is None:
        date = datetime.now().strftime("%Y-%m-%d")

    return record_query(start_date=date, end_date=date)


def format_records_for_display(records: List[Dict[str, Any]]) -> str:
    """
    格式化记录为可读的文本

    Args:
        records: 记录列表

    Returns:
        格式化后的文本
    """
    if not records:
        return "没有找到记录。"

    lines = []
    lines.append(f"找到 {len(records)} 条记录：")
    lines.append("")

    for record in records:
        record_type = record.get("type", "unknown")
        record_name = RECORD_TYPE_NAMES.get(record_type, record_type)
        timestamp = record.get("timestamp", "unknown")
        details = record.get("details", {})
        images = record.get("images", [])

        # 格式化时间
        try:
            dt = datetime.fromisoformat(timestamp)
            time_str = dt.strftime("%Y-%m-%d %H:%M")
        except Exception:
            time_str = timestamp

        # 格式化详情
        details_str = format_details_for_display(record_type, details)

        line = f"- [{time_str}] {record_name}: {details_str}"
        if images:
            line += f" 📷 {len(images)}张"
        lines.append(line)

    return "\n".join(lines)


def format_details_for_display(record_type: str, details: Dict[str, Any]) -> str:
    """
    格式化详情为可读文本

    Args:
        record_type: 记录类型
        details: 详情字典

    Returns:
        格式化后的详情文本
    """
    if not details:
        return ""

    type_details = RECORD_TYPE_DETAILS.get(record_type, {})
    fields = type_details.get("fields", {})

    parts = []
    for key, description in fields.items():
        if key in details:
            value = details[key]
            # 简单格式化值
            if isinstance(value, bool):
                value = "是" if value else "否"
            elif isinstance(value, (list, dict)):
                value = json.dumps(value, ensure_ascii=False)
            parts.append(f"{description}: {value}")

    return ", ".join(parts) if parts else json.dumps(details, ensure_ascii=False)


def find_record_by_id(record_id: str) -> tuple[Optional[Dict[str, Any]], Optional[Path], Optional[int]]:
    """
    按 ID 查找记录

    Args:
        record_id: 记录 ID

    Returns:
        (记录对象，文件路径，索引) 或 (None, None, None) 如果未找到
    """
    init_storage()

    # 遍历所有日期文件查找记录 (排除 index.json)
    if not RECORDS_DIR.exists():
        return None, None, None

    for file_path in sorted(RECORDS_DIR.glob("*.json")):
        # Skip index file
        if file_path.name == "index.json":
            continue
        records = load_records_from_file(file_path)
        for idx, record in enumerate(records):
            if record.get("id") == record_id:
                return record, file_path, idx

    return None, None, None


def record_get(record_id: str) -> Optional[Dict[str, Any]]:
    """
    按 ID 获取单条记录

    Args:
        record_id: 记录 ID

    Returns:
        记录字典，如果未找到返回 None
    """
    record, _, _ = find_record_by_id(record_id)
    return record


def record_update(
    record_id: str,
    details: Optional[Dict[str, Any]] = None,
    timestamp: Optional[str] = None,
    images: Optional[List[str]] = None,
) -> Dict[str, Any]:
    """
    更新现有记录

    Args:
        record_id: 记录 ID
        details: 更新的详情字段（可选，部分或全部）
        timestamp: 更新时间戳（可选）
        images: 更新的图片列表（可选）

    Returns:
        更新后的记录字典

    Raises:
        ValueError: 记录不存在时
    """
    record, file_path, idx = find_record_by_id(record_id)

    if record is None:
        raise ValueError(f"Record not found: {record_id}")

    # 更新字段
    if details is not None:
        record["details"] = details
    if timestamp is not None:
        record["timestamp"] = timestamp
        # 如果时间戳变化，可能需要移动记录到不同的日期文件
        new_date = datetime.fromisoformat(timestamp).strftime("%Y-%m-%d")
        old_date = record["date"]
        if new_date != old_date:
            record["date"] = new_date
            new_file_path = get_record_file_path(datetime.fromisoformat(timestamp))
            # 从原文件删除并添加到新文件
            records = load_records_from_file(file_path)
            records.pop(idx)
            save_records_to_file(file_path, records)
            file_path = new_file_path
            records = load_records_from_file(file_path)
            records.append(record)
            save_records_to_file(file_path, records)
            # Update index for both dates
            update_index_for_record(record, "add")  # Add to new date
            # Note: We should also decrement old date, but for simplicity we'll rebuild index
            return record
    if images is not None:
        record["images"] = images

    # 保存到文件
    records = load_records_from_file(file_path)
    records[idx] = record
    save_records_to_file(file_path, records)

    return record


def record_delete(record_id: str) -> bool:
    """
    删除记录

    Args:
        record_id: 记录 ID

    Returns:
        True 如果删除成功

    Raises:
        ValueError: 记录不存在时
    """
    record, file_path, idx = find_record_by_id(record_id)

    if record is None:
        raise ValueError(f"Record not found: {record_id}")

    # 删除关联的图片
    images = record.get("images", [])
    for image_path in images:
        full_path = IMAGES_DIR / image_path
        if full_path.exists():
            full_path.unlink()

    # 从文件中删除记录
    records = load_records_from_file(file_path)
    records.pop(idx)
    save_records_to_file(file_path, records)

    # 更新索引
    update_index_for_record(record, "remove")

    return True


