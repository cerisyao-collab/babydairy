class DuplicateRecordError(Exception):
    """Exception raised when duplicate record is detected within time window"""
    def __init__(self, similar_records: List[Dict[str, Any]], message: str = ""):
        self.similar_records = similar_records
        self.message = message
        super().__init__(self.message)

