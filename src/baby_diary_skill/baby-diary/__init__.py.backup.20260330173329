    record_id: str,
    details: Optional[Dict[str, Any]] = None,
    timestamp: Optional[str] = None,
    images: Optional[List[str]] = None,
) -> Dict[str, Any]:
    """
    更新现有记录

    Args:
        record_id: 记录 ID
        details: 更新的详情字段（可选，部分或全部）
        timestamp: 更新时间戳（可选）
        images: 更新的图片列表（可选）

    Returns:
        更新后的记录字典

    Raises:
        ValueError: 记录不存在时
    """
    record, file_path, idx = find_record_by_id(record_id)

    if record is None:
        raise ValueError(f"Record not found: {record_id}")

    # 更新字段
    if details is not None:
        record["details"] = details
    if timestamp is not None:
        record["timestamp"] = timestamp
        # 如果时间戳变化，可能需要移动记录到不同的日期文件
        new_date = datetime.fromisoformat(timestamp).strftime("%Y-%m-%d")
        old_date = record["date"]
        if new_date != old_date:
            record["date"] = new_date
            new_file_path = get_record_file_path(datetime.fromisoformat(timestamp))
            # 从原文件删除并添加到新文件
            records = load_records_from_file(file_path)
            records.pop(idx)
            save_records_to_file(file_path, records)
            file_path = new_file_path
            records = load_records_from_file(file_path)
            records.append(record)
            save_records_to_file(file_path, records)
            # Update index for both dates
            update_index_for_record(record, "add")  # Add to new date
            # Note: We should also decrement old date, but for simplicity we'll rebuild index
            return record
    if images is not None:
        record["images"] = images

    # 保存到文件
    records = load_records_from_file(file_path)
    records[idx] = record
    save_records_to_file(file_path, records)

    return record


def record_delete(record_id: str) -> bool:
    """
    删除记录

    Args:
        record_id: 记录 ID

    Returns:
        True 如果删除成功

    Raises:
        ValueError: 记录不存在时
    """
    record, file_path, idx = find_record_by_id(record_id)

    if record is None:
        raise ValueError(f"Record not found: {record_id}")

    # 删除关联的图片
    images = record.get("images", [])
    for image_path in images:
        full_path = IMAGES_DIR / image_path
        if full_path.exists():
            full_path.unlink()

    # 从文件中删除记录
    records = load_records_from_file(file_path)
    records.pop(idx)
    save_records_to_file(file_path, records)

    # 更新索引
    update_index_for_record(record, "remove")

    return True


