def daily_summary(date: Optional[str] = None, birth_date: Optional[str] = None) -> str:
    """
    生成每日近况总结，包含与标准值的对比分析

    Args:
        date: 日期 (YYYY-MM-DD), 默认为今天
        birth_date: 宝宝出生日期 (YYYY-MM-DD), 用于计算出生天数

    Returns:
        格式化后的总结报告
    """
    if date is None:
        date = datetime.now().strftime("%Y-%m-%d")

    # 获取当日所有记录
    records = record_query(start_date=date, end_date=date)

    if not records:
        return f"【{date}】 今日无记录\n\n请先添加宝宝的日常记录。"

    # 计算出生天数
    birth_day = None
    if birth_date:
        try:
            bd = datetime.strptime(birth_date, "%Y-%m-%d")
            target = datetime.strptime(date, "%Y-%m-%d")
            birth_day = get_birth_day(bd, target)
        except ValueError:
            birth_day = None

    # 分类统计
    stats = {
        "feeding": [],
        "bowel": [],
        "urine": [],
        "growth": [],
        "medication": [],
        "bathing": [],
        "sleep": [],
        "illness": [],
    }

    for r in records:
        rtype = r.get("type", "unknown")
        if rtype in stats:
            stats[rtype].append(r)

    # 构建总结
    lines = []
    lines.append(f"【{date}】 宝宝每日近况总结")
    if birth_day:
        lines.append(f"出生天数：第 {birth_day} 天")
    lines.append("")
    lines.append(f"今日记录总数：{len(records)} 条")
    lines.append("")

    # 喂养情况
    feeding_records = stats["feeding"]
    if feeding_records:
        total_feeding = len(feeding_records)
        total_milk = sum(r.get("details", {}).get("amount_ml", 0) for r in feeding_records)
        breast_count = sum(1 for r in feeding_records if r.get("details", {}).get("feeding_type") == "breast")
        formula_count = sum(1 for r in feeding_records if r.get("details", {}).get("feeding_type") in ["formula", "water_formula"])

        lines.append("🍼 喂养情况")
        lines.append(f"  喂养次数：{total_feeding} 次")
        if total_milk > 0:
            lines.append(f"  总奶量：{total_milk} ml")
        if breast_count > 0:
            lines.append(f"  亲喂：{breast_count} 次")
        if formula_count > 0:
            lines.append(f"  瓶喂：{formula_count} 次")

        # 对比标准值
        if birth_day:
            std_feeding = get_standard_for_day(birth_day, "feeding_times")
            std_milk = get_standard_for_day(birth_day, "milk_volume_ml")
            if std_feeding:
                feeding_analysis = compare_with_standards(total_feeding, std_feeding, "喂养次数")
                lines.append(f"  对比标准：{feeding_analysis['status']} ({feeding_analysis['difference']})")
                lines.append(f"  建议：{feeding_analysis['advice']}")
        lines.append("")

    # 排泄情况
    urine_records = stats["urine"]
    bowel_records = stats["bowel"]

    if urine_records or bowel_records:
        urine_count = sum(r.get("details", {}).get("count", 1) for r in urine_records)
        bowel_count = len(bowel_records)

        lines.append("💩 排泄情况")
        if urine_records:
            lines.append(f"  小便：{urine_count} 次")
        if bowel_records:
            colors = [r.get("details", {}).get("color", "") for r in bowel_records if r.get("details", {}).get("color")]
            colors_str = ", ".join(colors) if colors else ""
            lines.append(f"  大便：{bowel_count} 次" + (f" ({colors_str})" if colors_str else ""))

        # 对比标准值
        if birth_day:
            if urine_records:
                std_urine = get_standard_for_day(birth_day, "urine_count")
                if std_urine:
                    urine_analysis = compare_with_standards(urine_count, std_urine, "排尿次数")
                    lines.append(f"  排尿对比：{urine_analysis['status']} ({urine_analysis['difference']})")
            if bowel_records:
                std_bowel = get_standard_for_day(birth_day, "bowel_count")
                if std_bowel:
                    bowel_analysis = compare_with_standards(bowel_count, std_bowel, "大便次数")
                    lines.append(f"  大便对比：{bowel_analysis['status']} ({bowel_analysis['difference']})")
        lines.append("")

    # 生长指标
    growth_records = stats["growth"]
    if growth_records:
        lines.append("📏 生长指标")
        for r in growth_records:
            details = r.get("details", {})
            ts = r.get("timestamp", "")[:16]
            parts = []
            if "weight_kg" in details:
                parts.append(f"体重 {details['weight_kg']} kg")
            if "height_cm" in details:
                parts.append(f"身长 {details['height_cm']} cm")
            if "temperature" in details:
                parts.append(f"体温 {details['temperature']}°C")
            if parts:
                lines.append(f"  [{ts}] {', '.join(parts)}")

            # 对比标准值
            if birth_day:
                if "weight_kg" in details:
                    std_weight = get_standard_for_day(birth_day, "weight_kg")
                    if std_weight:
                        weight_analysis = compare_with_standards(details["weight_kg"], std_weight, "体重")
                        lines.append(f"    体重评估：{weight_analysis['status']} - {weight_analysis['advice']}")
                if "height_cm" in details:
                    std_height = get_standard_for_day(birth_day, "height_cm")
                    if std_height:
                        height_analysis = compare_with_standards(details["height_cm"], std_height, "身长")
                        lines.append(f"    身长评估：{height_analysis['status']} - {height_analysis['advice']}")
        lines.append("")

    # 其他记录
    if stats["medication"]:
        lines.append("💊 营养品")
        for r in stats["medication"]:
            details = r.get("details", {})
            name = details.get("name", "")
            dosage = details.get("dosage", "")
            if name:
                lines.append(f"  {name}: {dosage}")
        lines.append("")

    if stats["bathing"]:
        lines.append("🛁 洗澡")
        lines.append(f"  {len(stats['bathing'])} 次")
        lines.append("")

    if stats["sleep"]:
        lines.append("😴 睡眠")
        lines.append(f"  {len(stats['sleep'])} 条记录")
        lines.append("")

    if stats["illness"]:
        lines.append("🤒 病情")
        for r in stats["illness"]:
            details = r.get("details", {})
            symptom = details.get("symptom", "")
            if symptom:
                lines.append(f"  症状：{symptom}")
        lines.append("")

    # 综合建议
    lines.append("💡 综合建议")
    lines.append("  以上数据仅供参考，每个宝宝都有自己的成长节奏。")
    lines.append("  如有疑虑，请咨询儿科医生。")

    return "\n".join(lines)


