SUPPORTED_IMAGE_FORMATS = {'.jpg', '.jpeg', '.png', '.gif', '.webp', '.heic', '.heif'}


def get_image_full_path(image_filename: str) -> Path:
    """Get the full path for an image filename"""
    return IMAGES_DIR / image_filename


def is_supported_image_format(image_path: Path) -> bool:
    """Check if the image has a supported format"""
    return image_path.suffix.lower() in SUPPORTED_IMAGE_FORMATS


def generate_thumbnail(image_path: str, size: tuple = None) -> Optional[str]:
    """
    Generate a thumbnail for an image

    Args:
        image_path: Path to the source image (relative to IMAGES_DIR or absolute)
        size: Maximum thumbnail size (default: THUMBNAIL_SIZE)

    Returns:
        Path to the generated thumbnail (relative to IMAGES_DIR), or None if failed
    """
    if size is None:
        size = THUMBNAIL_SIZE

    # Handle both relative and absolute paths
    if Path(image_path).is_absolute():
        source_path = Path(image_path)
        rel_path = Path(image_path).relative_to(IMAGES_DIR) if str(image_path).startswith(str(IMAGES_DIR)) else Path(image_path).name
    else:
        source_path = IMAGES_DIR / image_path
        rel_path = Path(image_path)

    if not source_path.exists():
        return None

    # Create thumbnail filename
    thumb_filename = f"{rel_path.stem}_thumb{rel_path.suffix}"
    thumb_path = IMAGES_DIR / "thumbnails" / thumb_filename

    # Check if thumbnail already exists and is newer than source
    if thumb_path.exists():
        try:
            if thumb_path.stat().st_mtime >= source_path.stat().st_mtime:
                return str(Path("thumbnails") / thumb_filename)
        except OSError:
            pass

    try:
        from PIL import Image

        # Handle HEIC/HEIF formats
        if source_path.suffix.lower() in {'.heic', '.heif'}:
            try:
                from pillow_heif import HeifImagePlugin
                HeifImagePlugin.register_heif_opener()
            except ImportError:
                # HEIF support not available, try to open anyway
                pass

        with Image.open(source_path) as img:
            # Convert to RGB if necessary (for PNG with transparency)
            if img.mode in ('RGBA', 'LA', 'P'):
                img = img.convert('RGB')

            # Generate thumbnail maintaining aspect ratio
            img.thumbnail(size, Image.Resampling.LANCZOS)

            # Ensure thumbnails directory exists
            thumb_dir = thumb_path.parent
            thumb_dir.mkdir(parents=True, exist_ok=True)

            # Save thumbnail
            img.save(thumb_path, "JPEG", quality=85)

        return str(Path("thumbnails") / thumb_filename)

    except ImportError:
        # Pillow not installed
        return None
    except Exception:
        # Any other error during thumbnail generation
        return None


def image_view(record_id: str, image_index: int = 0) -> Dict[str, Any]:
    """
    View a single image from a record

    Args:
        record_id: The record ID to view image from
        image_index: Index of the image to view (default: 0)

    Returns:
        Dictionary with 'success', 'image_path', 'message', and 'markdown' keys
    """
    record = record_get(record_id)

    if not record:
        return {
            "success": False,
            "message": f"Record not found: {record_id}"
        }

    images = record.get("images", [])

    if not images:
        return {
            "success": False,
            "message": "No images attached to this record"
        }

    if image_index < 0 or image_index >= len(images):
        return {
            "success": False,
            "message": f"Image index {image_index} out of range. Record has {len(images)} image(s)."
        }

    image_filename = images[image_index]
    image_path = get_image_full_path(image_filename)

    if not image_path.exists():
        return {
            "success": False,
            "message": f"Image file not found: {image_filename}"
        }

    if not is_supported_image_format(image_path):
        return {
            "success": False,
            "message": f"Unsupported image format: {image_path.suffix}"
        }

    # Return markdown for displaying the image
    return {
        "success": True,
        "image_index": image_index,
        "total_images": len(images),
        "image_path": str(image_path),
        "message": f"Image {image_index + 1} of {len(images)}",
        "markdown": f"![Record Image {image_index + 1}]({image_path})"
    }


def list_images(record_id: str) -> Dict[str, Any]:
    """
    List all images for a record with thumbnails

    Args:
        record_id: The record ID to list images from

    Returns:
        Dictionary with 'success', 'images', 'count', and 'markdown' keys
    """
    record = record_get(record_id)

    if not record:
        return {
            "success": False,
            "message": f"Record not found: {record_id}"
        }

    images = record.get("images", [])

    if not images:
        return {
            "success": False,
            "message": "No images attached to this record"
        }

    result_images = []
    for idx, image_filename in enumerate(images):
        image_path = get_image_full_path(image_filename)
        thumb_path = None

        if image_path.exists():
            thumb_rel = generate_thumbnail(str(image_filename))
            if thumb_rel:
                thumb_path = str(IMAGES_DIR / thumb_rel)

        result_images.append({
            "index": idx,
            "filename": image_filename,
            "path": str(image_path),
            "thumbnail_path": thumb_path,
            "exists": image_path.exists()
        })

    # Build markdown output
    lines = [f"**Images for record {record_id}** ({len(images)} total)"]
    lines.append("")

    for img in result_images:
        if img["exists"]:
            display_path = img["thumbnail_path"] if img["thumbnail_path"] else img["path"]
            lines.append(f"**{img['index'] + 1}.** {img['filename']}")
            lines.append(f"![Thumbnail]({display_path})")
            lines.append("")
        else:
            lines.append(f"**{img['index'] + 1}.** {img['filename']} (file not found)")
            lines.append("")

    return {
        "success": True,
        "count": len(images),
        "images": result_images,
        "message": f"Found {len(images)} image(s)",
        "markdown": "\n".join(lines)
    }


def image_gallery(record_id: str) -> Dict[str, Any]:
    """
    Display multiple images from a record in a gallery/grid format

    Args:
        record_id: The record ID to display images from

    Returns:
        Dictionary with 'success', 'images', 'count', and 'markdown' keys
    """
    record = record_get(record_id)

    if not record:
        return {
            "success": False,
            "message": f"Record not found: {record_id}"
        }

    images = record.get("images", [])

    if not images:
        return {
            "success": False,
            "message": "No images attached to this record"
        }

    # Build markdown gallery output
    lines = [f"**Gallery: {len(images)} image(s)**"]
    lines.append("")

    # Single image - display full size
    if len(images) == 1:
        image_path = get_image_full_path(images[0])
        if image_path.exists():
            lines.append(f"![Image 1 of 1]({image_path})")
        else:
            lines.append("Image file not found")
    else:
        # Multiple images - display as grid (using numbered list with thumbnails)
        for idx, image_filename in enumerate(images):
            image_path = get_image_full_path(image_filename)
            if image_path.exists():
                # Try to show thumbnail
                thumb_rel = generate_thumbnail(str(image_filename))
                display_path = str(IMAGES_DIR / thumb_rel) if thumb_rel else str(image_path)
                lines.append(f"**Image {idx + 1} of {len(images)}:** {image_filename}")
                lines.append(f"![Image {idx + 1}]({display_path})")
                lines.append("")
            else:
                lines.append(f"**Image {idx + 1} of {len(images)}:** {image_filename} (file not found)")
                lines.append("")

    return {
        "success": True,
        "count": len(images),
        "message": f"Gallery with {len(images)} image(s)",
        "markdown": "\n".join(lines)
    }
